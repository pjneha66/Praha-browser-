mk_add_options MOZ_OBJDIR=/tmp/praha_obj
ac_add_options --enable-project=mobile/android
ac_add_options --target=aarch64-linux-android
ac_add_options --with-branding=mobile/android/branding/praha
ac_add_options --disable-crashreporter
ac_add_options --enable-artifact-builds
ac_add_options --with-android-sdk=/opt/homebrew/share/android-commandlinetools
ac_add_options --without-embedded-uniffi-bindgen
ac_add_options --without-nimbus-fml
# Keep xpinstall.signatures.required authoritative (see mozconfig-praha).
export MOZ_REQUIRE_SIGNING=



