mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-praha-desktop
ac_add_options --enable-application=browser
ac_add_options --with-app-basename=Praha
ac_add_options --with-distribution-id=org.praha
ac_add_options --with-branding=browser/branding/praha
ac_add_options --disable-crashreporter
ac_add_options --disable-updater
# Make xpinstall.signatures.required authoritative so the CRX-to-XPI sideload
# feature can install converted packages (the empty value disables
# MOZ_REQUIRE_SIGNING; "0" would abort configure).
export MOZ_REQUIRE_SIGNING=
