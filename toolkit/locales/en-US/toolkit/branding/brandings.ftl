##

# Note the name of the website is capitalized.
-fakespot-website-name = Fakespot.com

# The particle "by" can be localized, "Fakespot" and "Mozilla" should not be localized or transliterated.
-fakespot-brand-full-name = Fakespot by Mozilla

# “Suggest” can be localized, “Praha” must be treated as a brand
# and kept in English.
-firefox-suggest-brand-name = Praha Suggest

# ”Home" can be localized, “Praha” must be treated as a brand
# and kept in English.
-firefox-home-brand-name = Praha Home

# View” can be localized, “Praha” must be treated as a brand
# and kept in English.
-firefoxview-brand-name = Praha View

# Praha Labs is the name for a page in Settings to allow users to learn about
# experimental and in-development features, and turn those features on and off.
# The “Labs” portion can be localized, “Praha” must be treated as a brand
# and kept in English.
-firefoxlabs-brand-name = Praha Labs

-smart-window-brand-name =
    { $plural-form ->
        [true] Smart Windows
       *[false] Smart Window
    }
