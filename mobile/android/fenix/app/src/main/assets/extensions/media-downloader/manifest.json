{
  "manifest_version": 2,
  "name": "Praha Media & Power Suite",
  "version": "2.0.17",
  "description": "Built-in media detector, multi-threaded downloader, background playback, Chrome extension CRX converter, comic webtoon reader, DNS benchmarker, GPS spoofer, biometric vault, and WebTorrent streamer for Praha Browser",
  "browser_specific_settings": {
    "gecko": {
      "id": "media-downloader@prahabrowser.org",
      "strict_min_version": "115.0"
    },
    "gecko_android": {
      "strict_min_version": "115.0"
    }
  },
  "background": {
    "scripts": ["jszip.min.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "browser_action": {
    "default_area": "navbar",
    "default_icon": {
      "32": "icon_32.png",
      "64": "icon_64.png"
    },
    "default_title": "Praha Power Suite",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icon_16.png",
    "32": "icon_32.png",
    "48": "icon_48.png",
    "64": "icon_64.png",
    "128": "icon_128.png"
  },
  "web_accessible_resources": [
    "content.css",
    "webtorrent.html",
    "webtorrent.min.js",
    "jszip.min.js"
  ],
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "<all_urls>",
    "tabs",
    "storage",
    "unlimitedStorage",
    "downloads"
  ]
}
